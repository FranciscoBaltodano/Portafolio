{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist"],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "extend": {
    "keyframes": {
      "fadeIn": {
        "0%": { "opacity": 0 },
        "100%": { "opacity": 1 }
      }
    },
    "animation": {
      "fadeIn": "fadeIn 0.8s ease-in-out forwards"
    }
  }
}
//
